{
  "name": "@masterdeepak15/teamhub-cli",
  "version": "1.7.0",
  "type": "module",
  "license": "MIT",
  "description": "TeamHub — a self-hosted, project-aware MCP server + CLI for running a multi-agent Claude Code team (Team Lead plans/assigns, Developers code, Testers verify), with skills, a headless agent runner, one-command install/autostart, and a live monitoring dashboard (Kanban board, sprints, team, messages, real-time chat room) on the same port.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "multi-agent",
    "team",
    "task-management",
    "planner",
    "kanban",
    "dashboard",
    "cli"
  ],
  "homepage": "https://github.com/masterdeepak15/claude-team-protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masterdeepak15/claude-team-protocol.git"
  },
  "bin": {
    "teamhub": "dist/cli/teamhub-cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.html",
    "dist/**/*.css",
    "skills",
    "templates",
    "docs/CLI.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-public-assets.mjs",
    "teamhub": "node dist/teamhub/server.js",
    "agent": "node dist/agents/runner.js",
    "migrate": "node dist/scripts/migrate-legacy-to-teamhub.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.0",
    "cross-spawn": "^7.0.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
